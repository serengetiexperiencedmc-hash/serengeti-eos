# Local Development / Dev-Test only. Never use these values in UAT or Production.
# Copy to .env (gitignored). Do not commit real passwords.
# Production-like startup (EOS_ENV=production|uat or NODE_ENV=production) fails closed
# if required configuration is incomplete. Dev/Test services are never silently substituted.
#
# Placeholders below are NOT Production values, NOT a provider selection, and NOT a geography selection.
# Isolated Production does not exist. SEDMC is NOT Production Ready.
#
# PostgreSQL URL below matches infra/compose/dev.yaml (Development/Test compose only).
# That compose file does NOT deploy, lock, or represent Production infrastructure.

EOS_ENV=development
EOS_PORT=8080
# Listen defaults to 127.0.0.1 (Dev/Test isolation). Do not treat 0.0.0.0 as a selected Production architecture.
# Production-like requires EOS_LISTEN_HOST to be explicit and non-loopback (bind address remains UNSELECTED).
# Orchestrators that inject PORT must map it to EOS_PORT; the API does not read PORT.
# EOS_LISTEN_HOST=127.0.0.1
# Required when EOS_ENV=production|uat or NODE_ENV=production (fail-closed; Dev/Test fallback is refused).
EOS_TOKEN_SECRET=replace-with-long-random-dev-secret
EOS_TOKEN_TTL_SECONDS=3600

# PostgreSQL (compose: infra/compose/dev.yaml — DEV/TEST ONLY)
EOS_DATABASE_URL=postgres://eos:eos-dev-only@127.0.0.1:5432/eos
# Live Dev/Test `eos` is the validated 124-only F2 sidecar catalog. Do NOT run `npm run migrate`
# against this URL — CLI and API startup now refuse database name `eos`. Bounded sidecar:
# EOS_F2_DP01_BOUNDED_DEVTEST_API_STARTUP=true
# Isolated full-schema Dev/Test (H-112). Never the same catalog as `eos`. Create/reset:
#   CREATE DATABASE eos_h112_full;  (on the compose postgres, or a dedicated 5435 container)
# EOS_H112_FULL_SCHEMA_DEVTEST_API_STARTUP=true
# EOS_DATABASE_URL=postgres://eos:eos-dev-only@127.0.0.1:5432/eos_h112_full
# Bounded and full-schema opt-ins are mutually exclusive. Gate B / eos_gateb remain unauthorized.
# EOS_DATABASE_POOL_SIZE=10
# EOS_DATABASE_TLS_MODE=disable
# Production-like environments require EOS_DATABASE_TLS_MODE=require (certificates/product UNSELECTED).
# Production-like environments refuse loopback/localhost EOS_DATABASE_URL.

# Infrastructure target (portability label only — NOT Production authorization)
# EOS_INFRASTRUCTURE_TARGET=local-devtest
# EOS_INFRASTRUCTURE_TARGET=sedmc-owned-future
# EOS_INFRASTRUCTURE_TARGET=third-party-future

# Document bytes (DEV/TEST local filesystem). Production object store UNSELECTED.
# EOS_DOCUMENT_STORAGE=local-fs
# EOS_DOCUMENT_ROOT=

# Development bootstrap passwords via SecretsProvider env refs (never UAT/Prod).
# These match UI "Dev sign-in" / WORK_LOG documented credentials.
EOS_BOOTSTRAP_ALICE_PASSWORD=test-alice-not-for-prod
EOS_BOOTSTRAP_BOB_PASSWORD=test-bob-not-for-prod
EOS_BOOTSTRAP_CAROL_PASSWORD=test-carol-not-for-prod
EOS_BOOTSTRAP_PARTNER_PASSWORD=test-partner-not-for-prod

# Logging
EOS_LOG_LEVEL=info

# Email (I3.3 / I3.4 / I3.5) — default is Dev/Test outbox. Production email product is UNSELECTED.
# Production-like env refuses dev-outbox, smtp-stub, ses-stub, unknown adapters, loopback SMTP hosts,
# documented SES region placeholders, and Dev/Test .local From addresses. It does not select a vendor.
EOS_EMAIL_ADAPTER=dev-outbox
# EOS_EMAIL_ADAPTER=smtp
# EOS_EMAIL_ADAPTER=ses
# EOS_SMTP_HOST=127.0.0.1
# EOS_SMTP_PORT=1025
# EOS_SMTP_FROM=noreply@sedmc.local
# EOS_SMTP_USER=
# EOS_SMTP_PASS=
# EOS_SMTP_SECURE=false
# Production-like smtp requires EOS_SMTP_SECURE=true or port 465 (TLS). Product remains UNSELECTED.

# Public origin / CORS — Dev/Test is localhost HTTP only. Production hostname is UNSELECTED.
# Production-like requires EOS_PUBLIC_ORIGIN as https (not localhost, not wildcard). Do not invent a hostname.
# EOS_PUBLIC_ORIGIN=

# Amazon SES (I3.5) — example keys only. Region is NOT SELECTED. Not a Production geography decision.
# EOS_SES_REGION=REPLACE_WITH_PROVIDER_REGION_NOT_SELECTED
# EOS_SES_FROM=noreply@example.invalid
# EOS_SES_ACCESS_KEY_ID=
# EOS_SES_SECRET_ACCESS_KEY=
# Or use standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY with IAM role on host

# Event transport (I4.1 / I4.2) — default in-memory-dev; Production-like env refuses this substitution.
# Production NATS/JetStream product remains UNSELECTED (ADR-0004 pending ADR-0006).
# EOS_EVENT_TRANSPORT=in-memory-dev
# EOS_EVENT_TRANSPORT=nats-jetstream
# Production-like requires tls:// or nats+tls:// with URL userinfo (credential product UNSELECTED).
# EOS_NATS_URL=nats://127.0.0.1:4222
# EOS_NATS_URL=tls://nats-user:redacted@broker.example.invalid:4222
# Production-like env refuses loopback and plaintext nats://. NATS product remains UNSELECTED.
# EOS_NATS_STREAM=EOS_EVENTS
# EOS_NATS_SUBJECT_PREFIX=eos.events
# EOS_NATS_CONSUMER=EOS_PLATFORM_OBSERVER
# EOS_NATS_CONSUMER_ENABLED=true

# Load demo supplier + CRM data on API startup (Development only; refused in Production-like env)
EOS_SEED_DEMO=true

# Optional ops aliases for DLQ SLA digest fan-out (I4.17+); schedule POST …/dispatch-dlq-sla-digest via external cron (I4.18)
# EOS_DLQ_SLA_DIGEST_RECIPIENTS=ops@sedmc.local,oncall@sedmc.local
# Optional ops aliases for allowlist dual-control digest fan-out (I3.22)
# EOS_ALLOWLIST_DUAL_DIGEST_RECIPIENTS=approver@sedmc.local,ops@sedmc.local
# Hours after last DLQ SLA digest run before status is stale (I4.22; default 26)
# EOS_DLQ_SLA_DIGEST_STALE_HOURS=26
# Hours after last allowlist dual digest run before status is stale (I3.25; default 26)
# EOS_ALLOWLIST_DUAL_DIGEST_STALE_HOURS=26
