# Local Development only. Never use these values in UAT or Production.
# Copy to .env (gitignored). Do not commit real passwords.

EOS_ENV=development
EOS_PORT=8080
EOS_TOKEN_SECRET=replace-with-long-random-dev-secret
EOS_TOKEN_TTL_SECONDS=3600

# PostgreSQL (compose: infra/compose/dev.yaml)
EOS_DATABASE_URL=postgres://eos:eos-dev-only@127.0.0.1:5432/eos

# Development bootstrap passwords via SecretsProvider env refs (never UAT/Prod)
EOS_BOOTSTRAP_ALICE_PASSWORD=replace-me-alice
EOS_BOOTSTRAP_BOB_PASSWORD=replace-me-bob
EOS_BOOTSTRAP_CAROL_PASSWORD=replace-me-carol
EOS_BOOTSTRAP_PARTNER_PASSWORD=replace-me-partner

# Logging
EOS_LOG_LEVEL=info

# Email (I3.3 / I3.4)
EOS_EMAIL_ADAPTER=dev-outbox
# EOS_EMAIL_ADAPTER=smtp
# EOS_SMTP_HOST=127.0.0.1
# EOS_SMTP_PORT=1025
# EOS_SMTP_FROM=noreply@sedmc.local
# EOS_SMTP_USER=
# EOS_SMTP_PASS=
# EOS_SMTP_SECURE=false

# Event transport (I4.1) — default in-memory-dev; Production gate for nats-jetstream
# EOS_EVENT_TRANSPORT=in-memory-dev
# EOS_EVENT_TRANSPORT=nats-jetstream
# EOS_NATS_URL=nats://127.0.0.1:4222
# EOS_NATS_STREAM=EOS_EVENTS
# EOS_NATS_SUBJECT_PREFIX=eos.events

# Load demo supplier + CRM data on API startup (Development only)
EOS_SEED_DEMO=true
