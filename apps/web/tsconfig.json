{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-local/types/**/*.ts",
    ".next-local/dev/types/**/*.ts",
    ".next-h149-uat/types/**/*.ts",
    ".next-h149-uat/dev/types/**/*.ts",
    ".next-h151-d03/types/**/*.ts",
    ".next-h151-d03/dev/types/**/*.ts",
    ".next-h151-build/types/**/*.ts",
    ".next-h151-build/dev/types/**/*.ts",
    ".next-h152-build/types/**/*.ts",
    ".next-h152-build/dev/types/**/*.ts",
    ".next-h152-uat/types/**/*.ts",
    ".next-h152-uat/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
